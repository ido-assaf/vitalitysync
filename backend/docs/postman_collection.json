          "name": "Get created exercise",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/exercises/{{newExerciseId}}"
          }
        },
        {
          "name": "Update created exercise",
          "request": {
            "method": "PUT",
            "header": [
