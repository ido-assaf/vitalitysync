{
  "info": {
    "name": "VitalitySync Full-Stack API",
    "description": "Mounted Express routes for demonstrating authentication, MySQL CRUD, Sequelize relationships, workout flows, nutrition, AI, and admin monitoring. No provider or database secrets are included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminUserId",
      "value": "1"
    },
    {
      "key": "traineeUserId",
      "value": "3"
    },
    {
      "key": "workoutPlanId",
      "value": "3"
    },
    {
      "key": "newExerciseId",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "productBarcode",
      "value": "729000000001"
    },
    {
      "key": "nutritionProfileId",
      "value": "3"
    },
    {
      "key": "aiSpecialistId",
      "value": "1"
    },
    {
      "key": "evaluationId",
      "value": ""
    },
    {
      "key": "demoDate",
      "value": "2026-06-20"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "if (contentType.includes('application/json')) {",
          "  const body = pm.response.json();",
          "  pm.test('Uses the Assignment response envelope', function () {",
          "    pm.expect(body).to.have.property('success');",
          "    pm.expect(body).to.have.property('data');",
          "    pm.expect(body).to.have.property('error');",
          "    if (body.success) {",
          "      pm.expect(body.error).to.eql(null);",
          "    } else {",
          "      pm.expect(body.data).to.eql(null);",
          "      pm.expect(body.error).to.include.keys('code', 'message', 'details');",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 - Health",
      "item": [
        {
          "name": "Backend health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "2 - Authentication and current user",
      "item": [
        {
          "name": "Login as admin demo user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student.admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data && body.data.userId) {",
                  "  pm.collectionVariables.set('adminUserId', body.data.userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register trainee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Trainee\",\n  \"username\": \"postman.{{$randomUUID}}\",\n  \"email\": \"postman.{{$randomUUID}}@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Get current trainee",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{traineeUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "trainee"
              }
            ],
            "url": "{{baseUrl}}/api/users/me"
          }
        },
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{traineeUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "trainee"
              }
            ],
            "url": "{{baseUrl}}/api/settings"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "3 - Exercise CRUD",
      "item": [
        {
          "name": "List exercises",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/exercises"
          }
        },
        {
          "name": "Create exercise",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-user-id",
                "value": "{{adminUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "admin"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Cable Row\",\n  \"muscleGroup\": \"Back\",\n  \"mainMuscleGroup\": \"Back\",\n  \"subMuscleGroup\": \"Mid Back\",\n  \"equipment\": \"Cable\",\n  \"difficulty\": \"beginner\",\n  \"level\": \"beginner\",\n  \"movementPattern\": \"horizontal pull\",\n  \"goalTags\": [\"strength\", \"hypertrophy\"],\n  \"instructions\": [\"Sit tall\", \"Pull toward the torso\"],\n  \"source\": \"Postman demo\",\n  \"notes\": \"Temporary CRUD demonstration record.\"\n}"
            },
            "url": "{{baseUrl}}/exercises"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data && body.data.exerciseId) {",
                  "  pm.collectionVariables.set('newExerciseId', body.data.exerciseId);",
