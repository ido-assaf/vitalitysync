                "key": "x-user-id",
                "value": "{{adminUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "admin"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Seated Cable Row\",\n  \"muscleGroup\": \"Back\",\n  \"mainMuscleGroup\": \"Back\",\n  \"subMuscleGroup\": \"Mid Back\",\n  \"equipment\": \"Cable\",\n  \"difficulty\": \"beginner\",\n  \"level\": \"beginner\",\n  \"movementPattern\": \"horizontal pull\",\n  \"goalTags\": [\"strength\", \"hypertrophy\"],\n  \"instructions\": [\"Sit tall\", \"Pull toward the torso\", \"Control the return\"],\n  \"source\": \"Postman demo\",\n  \"notes\": \"Updated CRUD demonstration record.\"\n}"
            },
            "url": "{{baseUrl}}/exercises/{{newExerciseId}}"
          }
        },
        {
          "name": "Delete created exercise",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{adminUserId}}"
              },
              {
                "key": "x-user-role",
                "value": "admin"
              }
            ],
            "url": "{{baseUrl}}/exercises/{{newExerciseId}}"
          }
